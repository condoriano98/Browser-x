#include <winver.h>
#include <winuser.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@CMAKE_CURRENT_SOURCE_DIR@/win/launcher.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @BX_VERSION_MAJOR@,@BX_VERSION_MINOR@,@BX_VERSION_PATCH@,0
 PRODUCTVERSION @BX_VERSION_MAJOR@,@BX_VERSION_MINOR@,@BX_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "@BX_VENDOR@"
      VALUE "FileDescription", "@BX_NAME@ portable launcher"
      VALUE "FileVersion", "@BX_VERSION@"
      VALUE "InternalName", "BrowserX"
      VALUE "OriginalFilename", "BrowserX.exe"
      VALUE "ProductName", "@BX_NAME@"
      VALUE "ProductVersion", "@BX_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
